# ═══════════════════════════════════════════════════════════════════════════════
# Synalytix Backend — Railway Environment Variables
# Copy these to Railway Dashboard → Variables tab
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ─── Auth & Security ─────────────────────────────────────────────────────────
ENCRYPTION_SECRET=GENERATE_32_CHAR_RANDOM_STRING

# ─── CORS ────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# ─── OAuth — GitHub ──────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET

# ─── OAuth — Meta (Instagram) ───────────────────────────────────────────────
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET

# ─── OAuth — X (Twitter) ────────────────────────────────────────────────────
X_CLIENT_ID=YOUR_X_CLIENT_ID
X_CLIENT_SECRET=YOUR_X_CLIENT_SECRET

# ─── OAuth — LinkedIn ────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=YOUR_LINKEDIN_CLIENT_ID
LINKEDIN_CLIENT_SECRET=YOUR_LINKEDIN_CLIENT_SECRET

# ─── OAuth — Google Calendar ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ─── AI Providers (BYOK — optional, users provide their own) ────────────────
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY
OPENAI_API_KEY=YOUR_OPENAI_KEY
GEMINI_API_KEY=YOUR_GEMINI_KEY
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.4

# ─── Redis (optional — fallback to in-memory cache if not set) ──────────────
REDIS_URL=REDIS_URL_FROM_UPSTASH
