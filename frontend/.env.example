# Supabase Configuration (required)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Backend API URL (required for production)
# In development, leave empty to use Vite proxy (localhost:4000)
# In production, set to your backend URL (e.g., https://api.yourdomain.com)
VITE_API_BASE_URL=

# Feature toggles
# Set to true to redirect returning non-authenticated users from the landing page to the auth page
VITE_SHOW_LANDING_ONCE=true
